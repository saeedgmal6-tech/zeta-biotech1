{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zeta-biotech",
  "main": "worker.js",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ADMIN_USERNAME": "Saeed"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
